@page
@model Bumbu_Alexandra_Lab2.Pages.Books.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Book</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            Title
        </dt>
        <dd class="col-sm-10">
            @Model.Book.Title
        </dd>

        <dt class="col-sm-2">
            Author
        </dt>
        <dd class="col-sm-10">
            @(Model.Book.Author?.LastName ?? "")
        </dd>

        <dt class="col-sm-2">
            Price
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Book.Price)
        </dd>

        <dt class="col-sm-2">
            Publishing Date
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Book.PublishingDate)
        </dd>

        <dt class="col-sm-2">
            Publisher
        </dt>
        <dd class="col-sm-10">
            @(Model.Book.Publisher?.PublisherName ?? "")
        </dd>

        <dt class="col-sm-2">
            Categories
        </dt>
        <dd class="col-sm-10">
            @if (Model.Book.BookCategories != null &&
                 Model.Book.BookCategories.Any())
            {
                foreach (var category in Model.Book.BookCategories)
                {
                    <div>
                        @category.Category?.CategoryName
                    </div>
                }
            }
            else
            {
                <span>No categories assigned</span>
            }
        </dd>
    </dl>
</div>

<div>
    <a asp-page="./Edit"
       asp-route-id="@Model.Book.ID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
